#!/bin/sh
#
# Pi 5 HTTP-boot installer init (PID 1)
# - Brings up network (DHCP)
# - Partitions + formats NVMe (GPT: BOOT vfat + ROOT ext4)
# - Installs Debian rootfs + Pi firmware bundle
# - Writes cmdline.txt using ROOT *PARTUUID* (more robust at early boot)
# - Writes fstab using filesystem UUIDs
#

# PID 1 must not die silently; keep control on failure.
set -u

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

kmsg(){ echo "<6>[init] $*" > /dev/kmsg 2>/dev/null || true; }
log(){ echo "[init] $*"; kmsg "$*"; }
warn(){ echo "[init] WARN: $*"; kmsg "WARN: $*"; }
die(){ log "FATAL: $*"; exec sh; }

need_cmd() { command -v "$1" >/dev/null 2>&1 || die "Missing required command: $1"; }

# --- Minimal filesystem setup ---
mkdir -p /proc /sys /dev /run /tmp /mnt/root

mount -t proc  proc /proc  2>/dev/null || true
mount -t sysfs sys  /sys   2>/dev/null || true

# devtmpfs (retry briefly; early boot can race)
i=0
while ! mount -t devtmpfs dev /dev 2>/dev/null; do
  i=$((i+1))
  [ "$i" -ge 30 ] && break
  sleep 0.1
done

# Basic device nodes (avoid surprises)
[ -c /dev/console ] || mknod -m 600 /dev/console c 5 1 2>/dev/null || true
[ -c /dev/null ]    || mknod -m 666 /dev/null    c 1 3 2>/dev/null || true
[ -c /dev/kmsg ]    || mknod -m 600 /dev/kmsg    c 1 11 2>/dev/null || true

# Loopback (not strictly required, but helps some DHCP clients)
ip link set lo up 2>/dev/null || true

# --- Network: DHCP on eth0 (dhclient preferred; fallback to udhcpc) ---
log "DHCP on eth0..."
ip link set eth0 up 2>/dev/null || true

# Wait a moment for link/carrier if ethtool exists; otherwise just proceed.
if command -v ethtool >/dev/null 2>&1; then
  j=0
  while :; do
    ethtool eth0 2>/dev/null | grep -q "Link detected: yes" && break
    j=$((j+1))
    [ "$j" -ge 30 ] && break
    sleep 0.1
  done
fi

# If dhclient is present, make it deterministic in initramfs contexts.
if command -v dhclient >/dev/null 2>&1; then
  rm -f /run/dhclient.* /var/lib/dhcp/dhclient.* 2>/dev/null || true
  dhclient -4 -v -1 -pf /run/dhclient.pid -lf /run/dhclient.leases eth0 \
    || die "DHCP failed (dhclient)"
elif command -v udhcpc >/dev/null 2>&1; then
  # -n: exit if lease fails; -q: quiet-ish; -f: run in foreground
  udhcpc -i eth0 -n -q -f || die "DHCP failed (udhcpc)"
else
  die "No DHCP client found (need dhclient or udhcpc)"
fi

# Ensure DNS is present (some initramfs DHCP clients may not write resolv.conf)
if [ ! -s /etc/resolv.conf ]; then
  warn "/etc/resolv.conf is empty; writing a temporary resolver"
  echo "nameserver 192.168.3.3" > /etc/resolv.conf
fi

log "Synchronizing time (pre-cloud-init)..."
log "Time before: $(date -R 2>/dev/null || date)"

run() {
  log "+ $*"
  "$@" 2>&1 | while IFS= read -r line; do log "$line"; done
  rc=$?
  log "rc=$rc"
  return $rc
}

for c in ntpd sntp ntpdate rdate; do
  command -v "$c" >/dev/null 2>&1 && log "Time tool present: $c"
done

# ---- 1) NTP (best) ----
NTP_OK=0
if command -v ntpd >/dev/null 2>&1; then
  run ntpd -n -q -p 192.168.3.5 && NTP_OK=1 || true
  [ "$NTP_OK" -eq 1 ] || (run ntpd -n -q -p pool.ntp.org && NTP_OK=1) || true
  [ "$NTP_OK" -eq 1 ] || (run ntpd -n -q -p time.google.com && NTP_OK=1) || true
else
  log "ntpd not present in initramfs"
fi

log "Time after NTP: $(date -R 2>/dev/null || date)"

# ---- 2) Epoch fallback only if still wrong ----
YEAR="$(date +%Y 2>/dev/null || echo 0)"
if [ "$YEAR" -lt 2026 ]; then
  warn "Clock still invalid after NTP (year=$YEAR); using epoch fallback from ironhide"

  EPOCH=""
  if command -v curl >/dev/null 2>&1; then
    EPOCH="$(curl -fsS http://192.168.3.26/rpi/httpboot/time 2>/dev/null || true)"
  elif command -v wget >/dev/null 2>&1; then
    EPOCH="$(wget -qO- http://192.168.3.26/rpi/httpboot/time 2>/dev/null || true)"
  fi

  case "$EPOCH" in
    ''|*[!0-9]*)
      warn "Epoch fetch failed/invalid: ${EPOCH:-<empty>}"
      ;;
    *)
      run date -u -s "@$EPOCH" || true
      log "Time after epoch set: $(date -R 2>/dev/null || date)"
      ;;
  esac
else
  log "Clock looks sane after NTP (year=$YEAR); skipping epoch fallback"
fi

# --- Identify Pi (serial) ---
SERIAL="$(awk '/^Serial/ {print $3}' /proc/cpuinfo 2>/dev/null | tail -n1)"
[ -n "${SERIAL:-}" ] || die "No Serial found in /proc/cpuinfo"
log "Serial: $SERIAL"

# --- Config: HTTP endpoints ---
HTTP_BASE="http://192.168.3.26/rpi/httpboot"   # replaced by CI via sed
ART="${HTTP_BASE}/artifacts"
SEED="${HTTP_BASE}/seeds/${SERIAL}"

# --- Fetch helper (curl preferred; fallback to wget) ---
fetch() {
  url="$1"
  out="$2"
  rm -f "$out" 2>/dev/null || true
  if command -v curl >/dev/null 2>&1; then
    curl -fL --connect-timeout 10 --retry 5 --retry-delay 1 --retry-connrefused -o "$out" "$url" \
      || return 1
  elif command -v wget >/dev/null 2>&1; then
    wget -q --timeout=10 --tries=5 -O "$out" "$url" \
      || return 1
  else
    die "Neither curl nor wget is available"
  fi
  return 0
}

fetch_or_die() {
  url="$1"
  out="$2"
  fetch "$url" "$out" || die "Fetch failed: $url"
}

# --- Decompression helper (prefer zstd -dc; fallback unzstd -c) ---
zstd_cat() {
  in="$1"
  if command -v zstd >/dev/null 2>&1; then
    zstd -dc "$in"
  elif command -v unzstd >/dev/null 2>&1; then
    unzstd -c "$in"
  else
    die "Need zstd or unzstd to extract .tar.zst"
  fi
}

# --- Wait for NVMe device ---
log "Waiting for NVMe..."
i=0
while [ ! -b /dev/nvme0n1 ]; do
  i=$((i+1))
  [ "$i" -gt 300 ] && die "NVMe not found: /dev/nvme0n1"
  sleep 0.1
done

# Required tooling for the install flow
need_cmd parted
need_cmd mkfs.vfat
need_cmd mkfs.ext4
need_cmd blkid
need_cmd mount
need_cmd umount
need_cmd tar

# If udev exists, settle before manipulating partitions
if command -v udevadm >/dev/null 2>&1; then
  udevadm settle 2>/dev/null || true
fi

# --- Partition + format (DESTROYS DISK) ---
log "Partitioning NVMe (this will wipe /dev/nvme0n1)..."

# Best-effort unmounts if rerun
umount /mnt/root/boot/firmware 2>/dev/null || true
umount /mnt/root 2>/dev/null || true

# Wipe old signatures to avoid mkfs confusion (best effort)
if command -v wipefs >/dev/null 2>&1; then
  wipefs -a /dev/nvme0n1 2>/dev/null || true
fi

parted -s /dev/nvme0n1 mklabel gpt || die "parted mklabel failed"
parted -s /dev/nvme0n1 mkpart boot fat32 1MiB 512MiB || die "parted mkpart boot failed"
parted -s /dev/nvme0n1 set 1 esp on || die "parted set esp failed"
parted -s /dev/nvme0n1 mkpart root ext4 512MiB 100% || die "parted mkpart root failed"

# Notify kernel of partition table
if command -v partprobe >/dev/null 2>&1; then
  partprobe /dev/nvme0n1 2>/dev/null || true
fi

# If udev exists, settle again after partition changes
if command -v udevadm >/dev/null 2>&1; then
  udevadm settle 2>/dev/null || true
fi

# Wait for partition nodes
log "Waiting for NVMe partitions..."
i=0
while [ ! -b /dev/nvme0n1p1 ] || [ ! -b /dev/nvme0n1p2 ]; do
  i=$((i+1))
  [ "$i" -gt 200 ] && die "Partition nodes not present (/dev/nvme0n1p1,p2)"
  sleep 0.1
done

log "Formatting..."
mkfs.vfat -F32 -n BOOT /dev/nvme0n1p1 || die "mkfs.vfat failed"
mkfs.ext4 -F -L rootfs /dev/nvme0n1p2 || die "mkfs.ext4 failed"

# Ensure blkid sees the new UUIDs/PARTUUIDs
if command -v udevadm >/dev/null 2>&1; then
  udevadm settle 2>/dev/null || true
fi

ROOT_UUID="$(blkid -s UUID -o value /dev/nvme0n1p2 2>/dev/null || true)"
BOOT_UUID="$(blkid -s UUID -o value /dev/nvme0n1p1 2>/dev/null || true)"
ROOT_PARTUUID="$(blkid -s PARTUUID -o value /dev/nvme0n1p2 2>/dev/null || true)"
[ -n "${ROOT_UUID:-}" ] || die "Could not get ROOT_UUID"
[ -n "${BOOT_UUID:-}" ] || die "Could not get BOOT_UUID"
[ -n "${ROOT_PARTUUID:-}" ] || die "Could not get ROOT_PARTUUID"
log "ROOT_UUID=${ROOT_UUID}"
log "BOOT_UUID=${BOOT_UUID}"
log "ROOT_PARTUUID=${ROOT_PARTUUID}"

# --- Mount target ---
mount /dev/nvme0n1p2 /mnt/root || die "Mount root failed"
mkdir -p /mnt/root/boot/firmware
mount /dev/nvme0n1p1 /mnt/root/boot/firmware || die "Mount boot firmware failed"

# --- Install Debian rootfs ---
log "Fetching Debian rootfs..."
fetch_or_die "${ART}/debian-bookworm-arm64-rootfs.tar.zst" /tmp/rootfs.tar.zst

log "Extracting rootfs..."
zstd_cat /tmp/rootfs.tar.zst | tar -xpf - -C /mnt/root || die "Extract rootfs failed"

# --- Sanitize rootfs so NVMe boot is a true first boot ---
log "Sanitizing rootfs (cloud-init + machine-id + timesync state)..."

# Remove cloud-init state baked into the rootfs artifact (your June 2025 problem)
rm -rf /mnt/root/var/lib/cloud 2>/dev/null || true
rm -f  /mnt/root/var/log/cloud-init.log /mnt/root/var/log/cloud-init-output.log 2>/dev/null || true

# Force machine-id regeneration on first boot
rm -f /mnt/root/etc/machine-id 2>/dev/null || true
rm -f /mnt/root/var/lib/dbus/machine-id 2>/dev/null || true

# If present, remove any persisted timesync state
rm -f /mnt/root/var/lib/systemd/timesync/clock /mnt/root/var/lib/systemd/timesync/clock.* 2>/dev/null || true

# --- Install Pi firmware bundle ---
log "Fetching Pi firmware bundle..."
fetch_or_die "${ART}/pi-firmware.tar.zst" /tmp/pi-firmware.tar.zst

log "Installing firmware..."
zstd_cat /tmp/pi-firmware.tar.zst | tar -xpf - -C /mnt/root/boot/firmware || die "Extract firmware failed"

# --- Install matching Pi kernel modules (required for Docker networking, overlay, etc.) ---
log "Fetching Pi kernel modules bundle..."
fetch_or_die "${ART}/pi-modules.tar.zst" /tmp/pi-modules.tar.zst

log "Installing Pi kernel modules into /lib/modules..."
mkdir -p /mnt/root/lib/modules
zstd_cat /tmp/pi-modules.tar.zst | tar -xpf - -C /mnt/root/lib/modules || die "Extract modules failed"

# Force datasource selection
mkdir -p /mnt/root/etc/cloud/cloud.cfg.d
cat > /mnt/root/etc/cloud/cloud.cfg.d/99-datasource.cfg <<'EOF'
datasource_list: [ NoCloud-Net, None ]
EOF

cat > /mnt/root/etc/cloud/cloud.cfg.d/99-hostname.cfg <<'EOF'
preserve_hostname: false
EOF

# Remove any datasource overrides that might contain the invalid "NoCloud-Net"
rm -f /mnt/root/etc/cloud/cloud.cfg.d/*datasource* /mnt/root/etc/cloud/cloud.cfg.d/*NoCloud*

# Force the correct datasource list (note: NoCloudNet, no hyphen)
cat > /mnt/root/etc/cloud/cloud.cfg.d/99-datasource.cfg <<'EOF'
datasource_list: [ NoCloud, NoCloudNet ]
EOF

log "Writing NVMe cmdline.txt..."
cat > /mnt/root/boot/firmware/cmdline.txt <<EOF
console=ttyAMA10,115200 console=tty1 root=PARTUUID=${ROOT_PARTUUID} rootfstype=ext4 fsck.repair=yes rootwait ds=nocloud-net;s=${SEED}/
EOF

log "Writing NVMe config.txt..."
cat > /mnt/root/boot/firmware/config.txt <<'EOF'
arm_64bit=1
kernel=kernel_2712.img

enable_uart=1
uart_2ndstage=1
dtoverlay=disable-bt
EOF

log "Writing NVMe autoboot.txt..."
cat > /mnt/root/boot/firmware/autoboot.txt <<'EOF'
boot_partition=0
EOF

log "Writing fstab (filesystem UUIDs)..."
cat > /mnt/root/etc/fstab <<EOF
UUID=${ROOT_UUID}  /              ext4  defaults,noatime  0  1
UUID=${BOOT_UUID}  /boot/firmware vfat  defaults         0  2
EOF

# Extra safety: ensure everything is on disk before reboot
sync

# --- Clean unmount ---
umount /mnt/root/boot/firmware 2>/dev/null || true
umount /mnt/root 2>/dev/null || true
sync

log "Install complete; rebooting..."
reboot -f

# If reboot fails for some reason, drop to shell
exec sh
