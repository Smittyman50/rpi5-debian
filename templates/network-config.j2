auto {{ net.ifname }}
{% if net.mode == "static" %}
iface {{ net.ifname }} inet static
    address {{ net.address }}
    netmask {{ net.netmask }}
    gateway {{ net.gateway }}
{% if net.dns %}
    dns-nameservers {{ net.dns | join(' ') }}
{% endif %}
{% if net.search %}
    dns-search {{ net.search | join(' ') }}
{% endif %}
{% else %}
iface {{ net.ifname }} inet dhcp
{% endif %}
