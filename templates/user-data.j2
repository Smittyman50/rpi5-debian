#cloud-config
users:
  - name: {{ username }}
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: [sudo{% if docker | default(false) %}, docker{% endif %}]
    shell: /bin/bash
    passwd: {{ passwd_hash | default("") }}
    ssh_authorized_keys:
{%- for k in ssh_authorized_keys %}
      - {{ k }}
{%- endfor %}

ssh_pwauth: false
disable_root: true

package_update: true

packages:
  - openssh-server
{%- for p in packages %}
  - {{ p }}
{%- endfor %}
{%- if docker | default(false) %}
  - ca-certificates
  - curl
  - gnupg
{%- endif %}

timezone: {{ timezone | default("UTC") }}

runcmd:
  - [ bash, -lc, "systemctl enable --now ssh || true" ]
  - [ bash, -lc, "echo 'Provisioned via cloud-init' > /etc/provisioned.txt" ]
