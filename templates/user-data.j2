#cloud-config
locale: en_US.UTF-8
timezone: {{ timezone | default("UTC") }}

{% if net is defined and net %}
network:
  version: 2
  renderer: networkd
  ethernets:
    {{ net.ifname | default('end0') }}:
      dhcp4: {{ 'true' if (net.mode | default('dhcp')) == 'dhcp' else 'false' }}
      dhcp6: {{ 'true' if (net.dhcp6 | default(false)) else 'false' }}
{% if (net.mode | default('dhcp')) == 'static' %}
      addresses:
        - {{ net.address }}
      gateway4: {{ net.gateway }}
{% endif %}
{% if net.dns is defined or net.search is defined %}
      nameservers:
{% if net.dns is defined %}
        addresses:
{% for d in net.dns %}
          - {{ d }}
{% endfor %}
{% endif %}
{% if net.search is defined %}
        search:
{% for s in net.search %}
          - {{ s }}
{% endfor %}
{% endif %}
{% endif %}
{% endif %}

users:
  - name: {{ username }}
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: [sudo{% if docker | default(false) %}, docker{% endif %}]
    shell: /bin/bash
    lock_passwd: false
    passwd: {{ passwd_hash }}
    ssh_authorized_keys:
{% for k in ssh_authorized_keys %}
      - {{ k }}
{% endfor %}

ssh_pwauth: false
disable_root: true

package_update: true

packages:
  - openssh-server
  - ca-certificates
  - curl
  - vim
  - git
  - python3
  - duf
{% for p in packages %}
  - {{ p }}
{% endfor %}
{% if docker | default(false) %}
  - gnupg
{% endif %}

{# Write role list locally so the node is self-describing #}
{% if roles %}
write_files:
  - path: /etc/docker-roles.yml
    permissions: "0644"
    content: |
      docker_roles:
{% for r in roles %}
        - {{ r }}
{% endfor %}
{% endif %}

runcmd:
  - [ bash, -lc, "set -euo pipefail; systemctl enable --now ssh || true" ]
{%- if docker | default(false) %}
{# Docker install #}
  - [ bash, -lc, "set -euo pipefail; install -m 0755 -d /etc/apt/keyrings" ]
  - [ bash, -lc, "set -euo pipefail; curl -fsSL https://download.docker.com/linux/debian/gpg -o /tmp/docker.gpg" ]
  - [ bash, -lc, "set -euo pipefail; gpg --batch --yes --dearmor -o /etc/apt/keyrings/docker.gpg /tmp/docker.gpg" ]
  - [ bash, -lc, "set -euo pipefail; rm -f /tmp/docker.gpg" ]
  - [ bash, -lc, "set -euo pipefail; chmod a+r /etc/apt/keyrings/docker.gpg" ]
  - [ bash, -lc, "set -euo pipefail; echo 'deb [arch=arm64 signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable' > /etc/apt/sources.list.d/docker.list" ]
  - [ bash, -lc, "set -euo pipefail; apt-get update" ]
  - [ bash, -lc, "set -euo pipefail; apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin" ]
  - [ bash, -lc, "set -euo pipefail; systemctl enable --now docker" ]
  - [ bash, -lc, "set -euo pipefail; usermod -aG docker {{ username }} || true" ]
{% endif %}
{%- if docker | default(false) and roles %}
{# Apply docker role bundles #}
  - [ bash, -lc, "set -euo pipefail; command -v ansible-pull >/dev/null 2>&1 || (apt-get update && apt-get install -y ansible)" ]
  - [ bash, -lc, "set -euo pipefail; ansible-pull -U http://gitgard.home.arpa:3000/smittyman/docker-role-deploy.git -i localhost, -c local -e @/etc/docker-roles.yml site.yml || true" ]
{% endif %}
  - [ bash, -lc, "set -euo pipefail; echo '[cloud-init] switching networking from ifupdown to netplan+networkd' | systemd-cat -t cloud-init || true" ]
{# Enable the target stack for next boot #}
  - [ bash, -lc, "set -euo pipefail; systemctl enable systemd-networkd systemd-resolved || true" ]
  - [ bash, -lc, "set -euo pipefail; ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf || true" ]
{# Disable/remove ifupdown so it cannot interfere on next boot #}
  - [ bash, -lc, "set -euo pipefail; systemctl disable networking.service || true" ]
  - [ bash, -lc, "set -euo pipefail; rm -f /etc/network/interfaces; rm -rf /etc/network/interfaces.d || true" ]
  - [ bash, -lc, "set -euo pipefail; apt-get purge -y ifupdown || true" ]
{# Mark provisioning complete #}
  - [ bash, -lc, "set -euo pipefail; echo 'Provisioned via cloud-init' > /etc/provisioned.txt" ]

power_state:
  mode: reboot
  timeout: 30
  condition: true
