#cloud-config
locale: en_US.UTF-8
keyboard:
  layout: us
timezone: {{ timezone | default("UTC") }}

{% if pi.net is defined %}
network:
  version: 2
  ethernets:
    {{ pi.net.ifname | default('end0') }}:
      {% set ifcfg = (pi.net.ifname | default('end0')) %}
    {% endif %}

      dhcp4: {{ 'true' if pi.net.mode | default('dhcp') == 'dhcp' else 'false' }}
      dhcp6: {{ 'true' if (pi.net.dhcp6 | default(false)) else 'false' }}

      {% if (pi.net.mode | default('dhcp')) == 'static' %}
      addresses:
        - "{{ pi.net.address }}"
      routes:
        - to: default
          via: "{{ pi.net.gateway }}"
      {% if pi.net.dns is defined or pi.net.search is defined %}
      nameservers:
        {% if pi.net.dns is defined %}
        addresses: {{ pi.net.dns }}
        {% endif %}
        {% if pi.net.search is defined %}
        search: {{ pi.net.search }}
        {% endif %}
      {% endif %}
      {% endif %}
{% endif %}

users:
  - name: {{ username }}
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: [sudo{% if docker | default(false) %}, docker{% endif %}]
    shell: /bin/bash
    lock_passwd: false
    passwd: {{ passwd_hash }}
    ssh_authorized_keys:
{% for k in ssh_authorized_keys %}
      - {{ k }}
{% endfor %}

ssh_pwauth: false
disable_root: true

package_update: true

packages:
  - openssh-server
  - ca-certificates
  - curl
  - vim
  - git
  - python3
  - duf
{% for p in packages %}
  - {{ p }}
{% endfor %}
{% if docker | default(false) %}
  - gnupg
{% endif %}

{# Write role list locally so the node is self-describing #}
{% if roles %}
write_files:
  - path: /etc/docker-roles.yml
    permissions: "0644"
    content: |
      docker_roles:
{% for r in roles %}
        - {{ r }}
{% endfor %}
{% endif %}

runcmd:
  - [ bash, -lc, "systemctl enable --now ssh || true" ]
{%- if docker | default(false) %}
  # Docker (only when docker:true)
  - [ bash, -lc, "install -m 0755 -d /etc/apt/keyrings" ]
  - [ bash, -lc, "curl -fsSL https://download.docker.com/linux/debian/gpg -o /tmp/docker.gpg" ]
  - [ bash, -lc, "gpg --batch --yes --dearmor -o /etc/apt/keyrings/docker.gpg /tmp/docker.gpg" ]
  - [ bash, -lc, "rm -f /tmp/docker.gpg" ]
  - [ bash, -lc, "chmod a+r /etc/apt/keyrings/docker.gpg" ]
  - [ bash, -lc, "echo 'deb [arch=arm64 signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable' > /etc/apt/sources.list.d/docker.list" ]
  - [ bash, -lc, "apt-get update" ]
  - [ bash, -lc, "apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin" ]
  - [ bash, -lc, "systemctl enable --now docker" ]
  - [ bash, -lc, "usermod -aG docker {{ username }} || true" ]
{% endif %}
{%- if docker | default(false) and roles %}
  # Apply docker role bundles (public repo)
  - [ bash, -lc, "command -v ansible-pull >/dev/null 2>&1 || (apt-get update && apt-get install -y ansible)" ]
  - [ bash, -lc, "ansible-pull -U http://gitgard.home.arpa:3000/smittyman/docker-role-deploy.git -i localhost, -c local -e @/etc/docker-roles.yml site.yml || true" ]
{% endif %}
  - [ bash, -lc, "echo 'Provisioned via cloud-init' > /etc/provisioned.txt" ]

power_state:
  mode: reboot
  timeout: 30
  condition: true
